# AI Assistant (NAZ-16) — pluggable multi-provider chat.
# Set only the keys for the provider(s) you want to enable; any provider
# without a key falls back to a clearly-labelled demo-mode reply instead of
# erroring. Copy this file to .env.local and fill in what you have.

# Cassava AI Factory — internal token factory (OpenAI-compatible)
AI_FACTORY_API_KEY=
AI_FACTORY_BASE_URL=https://api.aifactory.cassavatech.com/v1
AI_FACTORY_MODEL=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Admin (/admin) — self-hosted Supabase, see terraform/README.md for how
# to stand up the instance and where these three values come from
# (terraform's supabase_url output, and the anon-key / service-role-key
# Key Vault secrets). Without these set, /admin is unreachable — every
# request redirects to /admin/login, which fails closed with "not
# configured" rather than silently granting access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix this NEXT_PUBLIC_. Bypasses Row Level
# Security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
